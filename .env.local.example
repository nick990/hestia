# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Solo server-side (Server Actions admin). Non esporre con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth mock (solo locale/preview — mai in produzione)
HESTIA_AUTH_MODE=mock
MOCK_AUTH_PASSWORD=dev123456

# Locale: valori da `supabase status` dopo `supabase start`
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
